<?xml version="1.0"?>
<robot name="dashgo">
  <material name="blue">
    <color rgba="0.10 0.30 0.90 0.90"/>
  </material>

  <material name="black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.82 0.84 0.88 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.96 0.46 0.12 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.32" radius="0.20"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="0.0 0.0 0.33" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.17"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <visual>
      <origin xyz="0.0 0.0 0.43" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.14" radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual>
      <origin xyz="0.0 0.0 0.49" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.07"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <visual>
      <origin xyz="0.13 0.12 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.014"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0.13 -0.12 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.014"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.0 0.17 0.065" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.065"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.0 -0.17 0.065" rpy="0 0 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.065"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.12 0.0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.52" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.30" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.045"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.008" radius="0.03"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>
</robot>
