<?xml version="1.0"?>
<package format="3">
  <name>dashgo_driver_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 driver package for Dashgo base controller.</description>

  <maintainer email="xu@example.com">xu</maintainer>
  <license>GPL-2.0-or-later</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>dashgo_lidar_ros2</exec_depend>
  <exec_depend>dashgo_realsense_ros2</exec_depend>
  <exec_depend>dashgo_web_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
