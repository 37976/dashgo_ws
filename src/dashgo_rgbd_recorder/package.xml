<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dashgo_rgbd_recorder</name>
  <version>0.1.0</version>
  <description>D435 RGB-D dataset recording and export tools for ORB-SLAM3</description>
  <maintainer email="clibang2022@163.com">boxing/喵了个水蓝蓝</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>dashgo_realsense_ros2</depend>

  <exec_depend>dashgo_driver_ros2</exec_depend>
  <exec_depend>dashgo_web_control</exec_depend>
